[app]
title = Vision AI
package.name = visionai
package.domain = org.vision
source.dir = .
version = 0.1
requirements = python3,kivy,gtts,vosk,pyaudio
orientation = portrait
android.api = 31
android.min_api = 21
android.ndk = 25b
android.permissions = INTERNET,RECORD_AUDIO,MODIFY_AUDIO_SETTINGS
source.include_exts = py,png,jpg,kv,atlas
